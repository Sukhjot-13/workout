{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "allowJs": true,
    "jsx": "preserve",
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["app/**/*.js", "components/**/*.jsx", "lib/**/*.js", "tests/**/*.js", "tests/**/*.jsx", "*.mjs"],
  "exclude": ["node_modules", ".next"]
}
