# Optional. Without it the tracker works fully offline on localStorage;
# with it, sessions sync to MongoDB (database: workout_tracker).
MONGODB_URI=mongodb://localhost:27017/workout_tracker

# ---------------------------------------------------------------------------
# Manager (centralized logging + analytics) — OPTIONAL.
# With none of these set the whole integration is a set of no-ops: the app
# behaves exactly as before. Read by lib/manager/index.js.
# ---------------------------------------------------------------------------

# Base URL of the MANAGER deployment — not this app's own port. Required to
# enable the integration. (Manager's own local default is http://127.0.0.1:3300.)
MANAGER_ENDPOINT=http://127.0.0.1:3300

# Project slug in Manager. Required to enable the integration.
MANAGER_APP_ID=workout

# Project log key. `mlk_…` for the server. Required to enable the integration.
MANAGER_LOG_KEY=

# Analytics key (`mak_…`) used by the injected tracker script. Optional:
# logs still work without it.
MANAGER_ANALYTICS_KEY=

# Optional. `server` (default) or `client`. Inferred when omitted.
MANAGER_LOG_SOURCE=server

# --- Browser half -------------------------------------------------------
# Next.js only inlines NEXT_PUBLIC_* into the client bundle, so the browser
# CANNOT read the MANAGER_* values above (process.env is empty in browser
# code, and a dynamic `process.env[name]` lookup is not inlined either).
# Without this block ManagerProvider stays silently disabled and no browser
# logs or analytics are ever sent.
#
# The value here is the project's CLIENT key (`mck_…`). Do NOT reuse
# MANAGER_LOG_KEY: Manager derives each entry's source from the key kind, so
# browser entries must carry the client key.
#
# This value is also read by next.config.mjs, which adds it to the CSP's
# connect-src — but ONLY when it is set. Unset, the policy is byte-identical
# to the pre-integration one.
NEXT_PUBLIC_MANAGER_ENDPOINT=http://127.0.0.1:3300
NEXT_PUBLIC_MANAGER_APP_ID=workout
NEXT_PUBLIC_MANAGER_CLIENT_KEY=
NEXT_PUBLIC_MANAGER_ANALYTICS_KEY=
